{
    "compilerOptions": {
       "target": "es2018",
       "module": "esnext",
       "moduleResolution": "bundler",
       "strict": true,
       "lib": [
          "DOM",
          "dom.iterable",
          "es5",
          "es2016",
          "es2015.collection",
          "es2015.iterable",
          "es2015.promise",
          "es2015.proxy",
          "es2018.promise",
          "es2016",
          "es2017.object",
          "es2018"
        ],
       "declaration": true,
       "outDir": "./build/esm",
       "sourceMap": true,
       "skipLibCheck": true,
       "paths": {
          "@excalibur-perlin": ["./src/"]
       },
      "types": [
        "@vitest/browser-playwright",
        "vitest/globals"
      ]
    },
    "include": [
      "example/**/*.ts",
      "./src/**/*.ts",
      "./test/unit/*.spec.ts",
      "./test/e2e/*.ts",
      "playwright.config.ts",
      "files.d.ts"
    ],
    "exclude": ["./example/**/*.tsx"]
 }
