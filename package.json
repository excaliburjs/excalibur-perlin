{
  "name": "@excaliburjs/plugin-perlin",
  "version": "1.0.0-alpha.0",
  "description": "Perlin noise generator for the Excalibur game engine",
  "main": "build/esm/excalibur-perlin.min.js",
  "typings": "build/esm/src/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/esm/src/index.d.ts",
      "import": "./build/esm/excalibur-perlin.js"
    }
  },
  "scripts": {
    "start": "vite example",
    "watch": "vite dev",
    "types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "type-check": "tsc --noEmit",
    "build:esm": "vite build && vite build --minify false",
    "build": "npm run build:esm && npm run types",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/excaliburjs/excalibur-perlin.git"
  },
  "author": "Erik Onarheim",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/excaliburjs/excalibur-perlin/issues"
  },
  "homepage": "https://github.com/excaliburjs/excalibur-perlin#readme",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.3",
    "excalibur": "0.33.0-alpha.247",
    "pixelmatch": "7.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "excalibur": ">=0.33.0-alpha.247"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error",
      "version": ">=11"
    }
  }
}
